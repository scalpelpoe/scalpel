{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@platform/*": ["packages/platform/src/*"],
      "@scalpel/platform/settings": ["packages/platform/src/common/platform-settings.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/plugin-sdk/**/*",
    "packages/platform/src/**/*",
    "packages/stream-contract/src/**/*",
    "src/renderer/src/env.d.ts",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/plugin-sdk/dist/**", "src/plugin-sdk/node_modules/**", "src/shared/data/filter/filter-actions.ts"]
}
