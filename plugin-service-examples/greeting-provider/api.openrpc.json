{
  "$schema": "https://spec.open-rpc.org/meta-schema.json",
  "openrpc": "1.4.0",
  "info": {
    "title": "Greeting Provider API",
    "version": "1.0.0",
    "description": "A minimal API used to prove manifest-declared plugin communication and client generation."
  },
  "methods": [
    {
      "name": "greet",
      "summary": "Create a greeting for an exile.",
      "paramStructure": "by-name",
      "params": [
        {
          "name": "name",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "greeting",
        "schema": {
          "$ref": "#/components/schemas/GreetResult"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "GreetResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "calls"],
        "properties": {
          "message": {
            "type": "string"
          },
          "calls": {
            "type": "integer"
          }
        }
      }
    }
  }
}
